<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
  <!-- One JSON object per audit line, no Boot prefix; ordinary application logging unchanged. -->
  <appender name="AUTH_AUDIT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%msg%n</pattern></encoder>
  </appender>
  <logger name="irv.auth.audit" level="INFO" additivity="false"><appender-ref ref="AUTH_AUDIT"/></logger>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
